# ~/.config/zsh/env.zsh — environment for EVERY zsh (managed by chezmoi:
# home/private_dot_config/zsh/env.zsh.tmpl). Sourced twice on purpose: from .zshenv
# (all shells) and again from .zprofile (login shells), because macOS's
# /etc/zprofile runs path_helper between the two and re-orders PATH; the second
# pass puts our dirs back in front. `typeset -U path` makes a re-prepend move an
# entry to the front instead of duplicating it, so sourcing twice is harmless.

# --- what this machine is (from the chezmoi config; see home/.chezmoi.toml.tmpl)
export DOTFILES_ENV={{ .env | quote }}
export DOTFILES_STATE_ROOT={{ .stateRoot | quote }}
{{- if eq .network "CN" }}
export DOTFILE_NETWORK_ENV=CN
{{- end }}

# Job-controller (jcc devpod) environment, injected by the platform — source it
# in every shell so its vars are present in non-interactive ones too.
[ -r "$HOME/.jc_env.sh" ] && . "$HOME/.jc_env.sh"
# Compatibility with the pre-chezmoi bootstrap's network marker.
[ -r "$HOME/.config/dotfiles/network-env" ] && . "$HOME/.config/dotfiles/network-env"

# --- portable session variables ---------------------------------------------
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
export NODE_REPL_HISTORY="$HOME/.node_history"
export NODE_REPL_HISTORY_SIZE=32768
export NODE_REPL_MODE=sloppy
export PYTHONIOENCODING=UTF-8
export MANPAGER="less -X"

# pnpm's home: where `pnpm add --global` puts bins (<PNPM_HOME>/bin) and where
# its content-addressable store lives. Each platform's own pnpm default, so an
# already-populated store keeps being found. pnpm refuses `add --global` unless
# this is set AND its bin dir is on PATH (below).
{{- if eq .chezmoi.os "darwin" }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}

# pi: point it at the REAL config dir rather than the ~/.pi symlink. Same
# directory either way, but npm records the unresolved prefix, and through the
# link every `pi install` re-resolves and duplicates the lockfile entries
# (measured: 331 entries with 330 escaped vs 0). Set here, not in .zshrc, so an
# editor extension host or an ACP server sees it too.
export PI_CODING_AGENT_DIR="{{ .stateRoot }}/.pi/agent"

# --- China mirrors, gated on one switch (never hardcoded) ---------------------
if [ "${DOTFILE_NETWORK_ENV:-}" = "CN" ]; then
  export UV_INDEX_URL="https://mirrors.cernet.edu.cn/pypi/web/simple"
  export PIP_INDEX_URL="https://mirrors.cernet.edu.cn/pypi/web/simple"
  export RUSTUP_UPDATE_ROOT="https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup"
  export RUSTUP_DIST_SERVER="https://mirrors.tuna.tsinghua.edu.cn/rustup"
fi

# Machine-local env fragments, one file per concern.
if [ -d "$HOME/.config/env.d" ]; then
  for f in "$HOME/.config/env.d/"*; do
    [ -r "$f" ] && . "$f"
  done
fi

# --- PATH ----------------------------------------------------------------------
typeset -U path PATH
path=(
  "$HOME/bin"
  "$HOME/.local/bin"           # zoi shims, mise/chezmoi/uv installers, agent CLIs
{{- if eq .chezmoi.os "darwin" }}
  # GNU userland first, unprefixed (brew installs g-prefixed names by default).
  /opt/homebrew/opt/coreutils/libexec/gnubin
  /opt/homebrew/opt/findutils/libexec/gnubin
  /opt/homebrew/opt/gnu-sed/libexec/gnubin
  /opt/homebrew/opt/grep/libexec/gnubin
  /opt/homebrew/bin
  /opt/homebrew/sbin
{{- end }}
  "$PNPM_HOME/bin"
  "$HOME/.pixi/bin"
  "$HOME/miniconda3/bin"
  /usr/local/cuda/bin
  $path
  # mise shims LAST, as a fallback: `mise activate zsh` (in .zshrc) prepends the
  # real tool dirs at the first prompt, but a process that is not an interactive
  # zsh — an editor extension host, an ACP server, a `just` recipe, .zshrc itself
  # before that first prompt — can still resolve every mise tool through here.
  "$HOME/.local/share/mise/shims"
)
export PATH

# --- the two machine-local escape hatches (created by scripts/env_links.py) ----
# Sourced last here, so ~/.exports beats a variable set above and ~/.path lands
# in front of the dirs above.
for f in "$HOME/.path" "$HOME/.exports"; do
  [ -r "$f" ] && . "$f"
done
