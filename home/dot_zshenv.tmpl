# ~/.zshenv — read by EVERY zsh (managed by chezmoi: home/dot_zshenv.tmpl).
# The whole environment is this chain, each link optional:
#   ~/.exports     variables (repo), ending in ~/.exports.local (machine-local)
#   ~/.path        PATH (repo), ending in ~/.path.local (machine-local)
#   ~/.jc_env.sh   the job-controller (jcc devpod) env, injected by the platform;
#                  last, so the platform's values win
# .zprofile and Claude Code's CLAUDE_ENV_FILE re-run this file; see each.
for f in "$HOME/.exports" "$HOME/.path" "$HOME/.jc_env.sh"; do
  [ -r "$f" ] && . "$f"
done
unset f
