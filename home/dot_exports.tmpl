# ~/.exports — environment variables for EVERY zsh (managed by chezmoi:
# home/dot_exports.tmpl). First link of the chain .zshenv runs:
#   ~/.exports (-> ~/.exports.local) -> ~/.path (-> ~/.path.local) -> ~/.jc_env.sh
# Machine-local variables and secrets go in ~/.exports.local, sourced at the end.

# --- what this machine is (from the chezmoi config; see home/.chezmoi.toml.tmpl)
export DOTFILES_ENV={{ .env | quote }}
export DOTFILES_STATE_ROOT={{ .stateRoot | quote }}
{{- if eq .network "CN" }}
export DOTFILE_NETWORK_ENV=CN
{{- end }}

# Compatibility with the pre-chezmoi bootstrap's network marker.
[ -r "$HOME/.config/dotfiles/network-env" ] && . "$HOME/.config/dotfiles/network-env"

# --- locale: keep the one we ask for, but only if it exists ------------------
# The jcc devpod image ships no `locales` package, so the only locales it has
# are C, C.utf8 and POSIX — while the container hands every process
# LANG=LC_ALL=en_US.UTF-8, inherited all the way from pid 1. Naming a locale
# that was never generated makes *every* bash print
#   bash: warning: setlocale: LC_ALL: cannot change locale (en_US.UTF-8)
# on stderr. Mostly cosmetic, twice not: a repo test asserting a subprocess
# writes nothing to stderr fails, which blocks the pre-push hook and teaches
# people to reach for --no-verify — on a hook that does catch real breakage.
# (The image's own /etc/locale.conf already says C.UTF-8; the inherited
# environment variable is what overrides it.)
#
# Probe rather than hard-code: glibc's `locale` complains on stderr when it
# cannot set what it was given, and stays quiet otherwise, so only a broken
# request falls back. Linux-only in practice — Darwin's locale(1) runs a bare
# unchecked setlocale(LC_ALL, "") and never diagnoses, so on macOS this is
# inert: en_US.UTF-8 survives because nothing fires, not because it passed.
# Just as well — macOS has no C.UTF-8, only a partial UTF-8 (PEP 538).
if command -v locale >/dev/null 2>&1 && [ -n "${LC_ALL:-${LANG:-}}" ]; then
  if [ -n "$(LC_ALL="${LC_ALL:-$LANG}" locale 2>&1 >/dev/null)" ]; then
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
  fi
fi
# The opposite failure: no locale at all. A GUI terminal that does not export
# one (Termius's and Tabby's local shells; launchd hands apps none) leaves zsh in
# the C locale, where it measures every multibyte prompt glyph (starship's ❯,
# Nerd Font icons) by its byte count. ZLE then redraws the input at the wrong
# column and typed text comes out doubled ("vim" shows as "vivim"). zsh re-runs
# setlocale when LANG is assigned, so exporting it here fixes this very shell.
if [ -z "${LC_ALL:-}${LC_CTYPE:-}${LANG:-}" ]; then
  if [[ $OSTYPE == darwin* ]]; then
    export LANG=en_US.UTF-8
  elif command -v locale >/dev/null 2>&1 && locale -a 2>/dev/null | grep -qix 'c\.utf-\{0,1\}8'; then
    export LANG=C.UTF-8
  fi
fi

# --- portable session variables ---------------------------------------------
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
export NODE_REPL_HISTORY="$HOME/.node_history"
export NODE_REPL_HISTORY_SIZE=32768
export NODE_REPL_MODE=sloppy
export PYTHONIOENCODING=UTF-8
export MANPAGER="less -X"

# Claude Code's auto-memory plane, off (2026-09-17). It is a third memory store on
# top of the retired local `memory` MCP server and nmem, writing per-project files
# under ~/.claude/projects/*/memory that no other agent can read. nmem is the one
# memory the toolchain keeps. The settings key `autoMemoryEnabled: false` says the
# same thing for the CLI; this covers every process that reads the environment.
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

# pnpm's home: where `pnpm add --global` puts bins (<PNPM_HOME>/bin) and where
# its content-addressable store lives. Each platform's own pnpm default, so an
# already-populated store keeps being found. pnpm refuses `add --global` unless
# this is set AND its bin dir is on PATH (below).
{{- if eq .chezmoi.os "darwin" }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}

# pi: point it at the REAL config dir rather than the ~/.pi symlink. Same
# directory either way, but npm records the unresolved prefix, and through the
# link every `pi install` re-resolves and duplicates the lockfile entries
# (measured: 331 entries with 330 escaped vs 0). Set here, not in .zshrc, so an
# editor extension host or an ACP server sees it too.
export PI_CODING_AGENT_DIR="{{ .stateRoot }}/.pi/agent"

# --- China mirrors, gated on one switch (never hardcoded) ---------------------
if [ "${DOTFILE_NETWORK_ENV:-}" = "CN" ]; then
  export UV_INDEX_URL="https://mirrors.cernet.edu.cn/pypi/web/simple"
  export PIP_INDEX_URL="https://mirrors.cernet.edu.cn/pypi/web/simple"
  export RUSTUP_UPDATE_ROOT="https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup"
  export RUSTUP_DIST_SERVER="https://mirrors.tuna.tsinghua.edu.cn/rustup"
fi

# --- Node via nvm (home/.chezmoidata/node.toml); ~/.path puts its bin on PATH --
export NVM_DIR="$HOME/.nvm"

# --- the machine-local hatch (created by scripts/env_links.py) -----------------
# Sourced last, so a variable set here beats one set above.
[ -r "$HOME/.exports.local" ] && . "$HOME/.exports.local"
