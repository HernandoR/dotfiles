#!/bin/sh
# The Node ecosystem via nvm (scripts/node.py): nvm, Node LTS, pnpm and the
# global npm packages. Re-runs when the list or the script changes:
#   node.toml: {{ include ".chezmoidata/node.toml" | sha256sum }}
#   node.py:   {{ include (joinPath .chezmoi.workingTree "scripts" "node.py") | sha256sum }}
set -eu
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "node: uv not on PATH — run ./bootstrap.sh first" >&2; exit 1; }
exec uv run --script "{{ .chezmoi.workingTree }}/scripts/node.py"
