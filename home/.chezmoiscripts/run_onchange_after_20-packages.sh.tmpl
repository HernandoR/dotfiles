#!/bin/sh
# The system-level remainder from the OS package manager (scripts/packages.py) —
# most tools come from mise (10-mise-runtimes). Re-runs only
# when the inventory or the installer changes:
#   packages.toml: {{ include ".chezmoidata/packages.toml" | sha256sum }}
#   packages.py:   {{ include (joinPath .chezmoi.workingTree "scripts" "packages.py") | sha256sum }}
set -eu
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "packages: uv not on PATH — run ./bootstrap.sh first" >&2; exit 1; }
exec uv run --script "{{ .chezmoi.workingTree }}/scripts/packages.py" --yes
