#!/bin/sh
# Materialize the mise runtimes ~/.config/mise/config.toml declares (seeded from
# .chezmoidata/mise.toml by env_links.py on a first run; mise's own afterwards).
# Re-runs when the seed changes — which reaches an existing host only via
# `mise use -g <tool>@<version>` there (README: "mise — global").
#   mise.toml: {{ include ".chezmoidata/mise.toml" | sha256sum }}
set -eu
export PATH="$HOME/.local/bin:$PATH"
if command -v mise >/dev/null 2>&1; then
  mise install -y || echo "mise: some runtimes failed to install — re-run 'just runtimes'" >&2
else
  echo "mise: not on PATH — run ./bootstrap.sh" >&2
fi
