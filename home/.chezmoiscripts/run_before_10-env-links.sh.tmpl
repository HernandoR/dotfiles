#!/bin/sh
# Runs BEFORE chezmoi writes any file, on every apply: seed / repair / place the
# mutable $HOME links from home/.chezmoidata/envlinks.toml. See scripts/env_links.py.
set -eu
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "env-links: uv not on PATH — bootstrap tools did not install" >&2; exit 1; }
exec uv run --script "{{ .chezmoi.workingTree }}/scripts/env_links.py" \
  --state-root {{ .stateRoot | quote }} --env {{ .env | quote }}
