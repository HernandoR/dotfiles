#!/bin/sh
# The imperative remainder (scripts/setup.py): login shell, mise runtimes,
# the coding-agent toolchain (ADR-0011/0012), opt-in system components. Re-runs
# when the manifest, the setup code or the selection changes:
#   agents.py:  {{ include (joinPath .chezmoi.workingTree "scripts" "agents.py") | sha256sum }}
#   setup.py:   {{ include (joinPath .chezmoi.workingTree "scripts" "setup.py") | sha256sum }}
#   components: {{ include (joinPath .chezmoi.workingTree "scripts" "components.py") | sha256sum }}
#   selection:  agents={{ .agents }} system={{ .system }}
set -eu
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "setup: uv not on PATH — run ./bootstrap.sh first" >&2; exit 1; }
# Unattended by construction: setup.py only asks with --interactive, which this
# never passes — a prompt here would hang the whole `chezmoi apply`.
exec uv run --script "{{ .chezmoi.workingTree }}/scripts/setup.py" \
  --agents {{ .agents | quote }} --system {{ .system | quote }}
