{{- /*
chezmoi config template — rendered ONCE by `chezmoi init` into
~/.config/chezmoi/chezmoi.toml, then read on every `chezmoi apply`. This is the
single place a machine says what it is (ADR-0013). The values used to live on a
`prod/*` branch (one Nix file per environment); now they are config data, so every host
runs the same `main`.

Resolution order for every value: environment variable (unattended runs, the
bootstrap's flags) > the answer already stored in the config (re-init keeps it)
> the default.

NOTHING IS ASKED unless DOTFILE_INTERACTIVE=1 (`./bootstrap.sh --interactive`,
`just init`). A question that blocks is the wrong behaviour where this is
usually run — CI, a container build, a devpod recreation, an agent's shell — so
being asked is the opt-in, and every answer has a working default.
*/ -}}
{{- $ask := and (eq (env "DOTFILE_INTERACTIVE") "1") stdinIsATTY -}}
{{- $env := or (env "DOTFILE_ENV") (index . "env") (and $ask (promptStringOnce . "env" "Environment (default | mewtant | ec2-wo-fsx)" "default")) "default" -}}
{{- /* Persistent state root for the env links (scripts/env_links.py). Known
       environments keep the roots the prod branches used; anything else lands
       under $HOME. */ -}}
{{- $stateDefault := joinPath .chezmoi.homeDir "dotfile_home" -}}
{{- if eq $env "mewtant" }}{{ $stateDefault = "/fsx/hernando/dotfile_home_link_src" }}{{ end -}}
{{- if eq $env "ec2-wo-fsx" }}{{ $stateDefault = "/home/ec2-user/dotfile_home" }}{{ end -}}
{{- $stateRoot := or (env "DOTFILE_STATE_ROOT") (index . "stateRoot") (and $ask (promptStringOnce . "stateRoot" "Persistent state root for the $HOME links" $stateDefault)) $stateDefault -}}
{{- $network := or (env "DOTFILE_NETWORK_ENV") (index . "network") (and $ask (promptStringOnce . "network" "Network (empty = upstream, CN = China mirrors)" "")) "" -}}
{{- $agents := or (env "DOTFILE_AGENTS") (index . "agents") (and $ask (promptStringOnce . "agents" "Coding agents to provision (all | claude,codex,pi | none)" "all")) "all" -}}
{{- $system := or (env "DOTFILE_SYSTEM_COMPONENTS") (index . "system") (and $ask (promptStringOnce . "system" "Linux system components (default | all | none | docker,cuda,...)" "default")) "default" -}}

# Generated by chezmoi from home/.chezmoi.toml.tmpl — edit THAT, then
# `chezmoi init` (answers are kept) or `chezmoi init --data=false`.

# The clone IS the source: no copy under ~/.local/share/chezmoi.
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    env = {{ $env | quote }}
    stateRoot = {{ $stateRoot | quote }}
    network = {{ $network | quote }}
    agents = {{ $agents | quote }}
    system = {{ $system | quote }}

[diff]
    exclude = ["scripts"]

[git]
    autoCommit = false
    autoPush = false
